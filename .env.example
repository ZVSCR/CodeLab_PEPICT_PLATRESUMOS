# Copie para .env e preencha. Nunca commite o .env.

# --- Django ---
# Em desenvolvimento: DEBUG=True. Em produção: DEBUG=False.
DEBUG=False
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Domínios/IP do servidor, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1
# Endereços completos (com https://) de onde vêm os formulários
CSRF_TRUSTED_ORIGINS=
# Cookies só por HTTPS. Padrão: ligado quando DEBUG=False.
# Use HTTPS=False só para testar o servidor por HTTP antes de configurar o certificado.
# HTTPS=True

# --- Banco de dados ---
# Desenvolvimento fora do Docker (runserver no seu PC): aponta pro Postgres do docker-compose.yml.
# Dentro do Docker (dev e produção) o compose monta a DATABASE_URL sozinho a partir das POSTGRES_*.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plataforma_resumos

# --- Postgres (container "db") ---
# Em produção, troque o POSTGRES_PASSWORD por uma senha forte
# (gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
POSTGRES_DB=plataforma_resumos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Porta do banco no seu PC (só o docker-compose.yml de desenvolvimento usa)
POSTGRES_PORT=5432

# --- Container ---
# Número de processos do gunicorn (regra comum: 2 x núcleos + 1)
WEB_CONCURRENCY=3
