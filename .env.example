# Copie para .env e preencha. Nunca commite o .env.

# --- Django ---
# Em desenvolvimento: DEBUG=True. Em produção: DEBUG=False.
DEBUG=False
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Domínios/IP do servidor, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1
# Endereços completos (com https://) de onde vêm os formulários
CSRF_TRUSTED_ORIGINS=

# --- Banco de dados ---
# Produção: string de conexão do Neon (host direto, sem "-pooler", e mantenha ?sslmode=require)
# DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Desenvolvimento: Postgres local do docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plataforma_resumos

# --- Postgres local (só usado pelo docker-compose.yml de desenvolvimento) ---
POSTGRES_DB=plataforma_resumos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Container ---
# Número de processos do gunicorn (regra comum: 2 x núcleos + 1)
WEB_CONCURRENCY=3
